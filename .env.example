HOST=127.0.0.1
PORT=3000
LAYA_MODEL_DIR=models/english/onnx
# Set this when exposing the API outside your local machine.
# LAYA_API_KEY=replace-with-a-secret
# Optional, for authenticated Hub downloads:
# HF_TOKEN=hf_...
# Download/export only: english | multilingual | typed-decisions
LAYA_CHECKPOINT=english

# Docker Compose host ports (container ports remain 3000 and 3001):
# DOCKER_API_PORT=3000
# DOCKER_PLAYGROUND_PORT=3001
